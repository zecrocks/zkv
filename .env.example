# zkv-oracle configuration. Copy to `.env` and fill in the secrets.
# `docker compose` reads this file automatically (env_file).

# --- required ---------------------------------------------------------------

# Testnet 24-word recovery phrase for the oracle's admin wallet. The wallet
# must already hold testnet ZEC (TAZ) and the database must already be INITed
# on-chain for this seed (restore-only bootstrap does not broadcast INIT).
ZKV_ORACLE_SEED=

# CoinGecko Pro API key (https://pro-api.coingecko.com).
COINGECKO_API_KEY=

# --- optional (defaults shown) ----------------------------------------------

# zkv database name.
# ZKV_DB=oracle-testnet

# Data directory inside the container (matches the mounted volume).
# ZKV_DATA=/data

# Wallet birthday height for the initial restore (omit to use chain tip - 10;
# historical memos before this height will not be visible).
# ZKV_BIRTHDAY=

# lightwalletd server: "zecrocks" (testnet.zec.rocks), "ecc", or a
# comma-separated host:port list.
# ZKV_SERVER=zecrocks

# Publish cadence in seconds (default 15 minutes).
# ZKV_INTERVAL_SECS=900

# Health gate bind address inside the container.
# ZKV_HEALTH_ADDR=0.0.0.0:8099

# Health gate thresholds. Unhealthy if the wallet scan is more than
# ZKV_MAX_LAG_BLOCKS behind the chain tip, or if no successful write has
# landed within ZKV_MAX_WRITE_AGE_SECS (default: twice the interval).
# ZKV_MAX_LAG_BLOCKS=50
# ZKV_MAX_WRITE_AGE_SECS=1800
